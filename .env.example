# ---------------------------------------------------------------------------
# Selective platform - single shared environment file
#
# This ONE file at the repo root is the single source of truth for env vars.
# Both apps (admin-frontend and client-frontend) load it via Vite `envDir`,
# and the Convex CLI reads it when running `convex dev` / `convex deploy`.
#
# Copy this file to `.env` and fill in the values. `convex dev` will populate
# the two values below for you automatically the first time you run it.
# ---------------------------------------------------------------------------

# Set automatically by `npx convex dev` (identifies your dev deployment).
CONVEX_DEPLOYMENT=

# Your Convex deployment URL, e.g. https://your-deployment.convex.cloud
# Both frontends read this (must be prefixed with VITE_ to be exposed to Vite).
VITE_CONVEX_URL=

# ---------------------------------------------------------------------------
# Clerk authentication (admin-frontend)
# One shared Clerk application serves both frontends. From Clerk Dashboard >
# API keys. Use pk_test_/sk_test_ in dev, pk_live_/sk_live_ in prod.
# ---------------------------------------------------------------------------

# Client-side (exposed to the browser bundle). Publishable key only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Server-side ONLY. Never prefix with VITE_ and never expose to the client.
CLERK_SECRET_KEY=sk_test_xxx

# Point Clerk components at our custom admin sign-in page. After sign-in,
# send staff home — never leave <SignIn> mounted on an active session.
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Clerk Frontend API URL / issuer domain, used by Convex to validate tokens.
# ALSO set it on the Convex deployment (it is read there, not from this file):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-instance>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Shared secret for the one-off bulk data importer (scripts/importNipon.mjs).
# ALSO set it on the Convex deployment: npx convex env set IMPORT_SECRET <value>
IMPORT_SECRET=change-me
